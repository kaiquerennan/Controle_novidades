# Copie este arquivo para .env e preencha os valores.
# O .env fica fora do repositorio (esta no .gitignore).
# Variaveis ja definidas no ambiente do terminal continuam tendo precedencia.

# Chave do provedor de IA. Preencha a do provedor que voce usa.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Assina o cookie que identifica cada navegador. Precisa ser estavel entre
# reinicios; em branco, o proprio sistema gera e guarda em
# data/storage_secret.local.
EMC_STORAGE_SECRET=

# Banco de ocorrencias (SQL Server). Opcional: sem estas variaveis vale o que
# esta em data/occurrence_db.local.json, gravado por configurar_banco.py.
EMC_DB_HOST=
EMC_DB_PORT=1433
EMC_DB_NAME=
EMC_DB_USER=
EMC_DB_PASSWORD=
EMC_DB_ODBC_DRIVER=
